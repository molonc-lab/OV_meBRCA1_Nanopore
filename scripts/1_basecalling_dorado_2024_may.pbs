#PBS -r n
#PBS -l mem=50GB,walltime=300:00:00,ncpus=16,ngpus=1
#PBS -q gpu
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load samtools/1.17

mkdir -p "${wk_dir}/output/${SampleID}"
mkdir -p "${wk_dir}/output/${SampleID}/QC"

pod5_files="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/data/${SampleID}/POD5/"
reference_fa="/reference/genomes/GRCh38_no_alt_analysis_set/primary_files/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa"
dorado="/working/lab_nicw/jiaZ/local/dorado/dorado-0.5.1-linux-x64/bin/dorado"

#model path
dorado_model="/working/lab_nicw/jiaZ/data/ont_models/dna_r10.4.1_e8.2_400bps_sup@v4.3.0"
remora_model="/working/lab_nicw/jiaZ/data/ont_models/dna_r10.4.1_e8.2_400bps_sup@v4.3.0_5mCG_5hmCG@v1"

#define output
bam_output="${wk_dir}/output/${SampleID}/${SampleID}_sup.bam"
summary_output="${wk_dir}/output/${SampleID}/QC/${SampleID}_summary.tsv"

$dorado basecaller $dorado_model \
$pod5_files \
--modified-bases-models $remora_model \
--recursive --reference $reference_fa > $bam_output

$dorado summary $bam_output > $summary_output