#PBS -r n
#PBS -l mem=40GB,walltime=30:00:00,ncpus=10
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load samtools/1.17
module load mosdepth/0.2.9
module load htslib/1.19.1
module load python/3.6.1
module load singularity/3.7.1
export OMP_NUM_THREADS=10

mkdir -p ${wk_dir}/output/${SampleID}/CNV
mkdir -p ${wk_dir}/output/${SampleID}/coverage


# parameters
reference_fa="/reference/genomes/GRCh38_no_alt_analysis_set/indexes/MINIMAP2/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa"
summary_output="${wk_dir}/output/${SampleID}/QC/${SampleID}_summary.tsv"
bam_mapped="${wk_dir}/output/${SampleID}/${SampleID}_mapped.bam"

delly_cnv_out_bcf="${wk_dir}/output/${SampleID}/CNV/${SampleID}_delly_cnv_out.cov.bcf"
delly_cnv_out="${wk_dir}/output/${SampleID}/CNV/${SampleID}_delly_cnv_out.cov.gz"
delly_cnv_tumour_bcf="${wk_dir}/output/${SampleID}/CNV/${SampleID}_delly_cnv_tumour.bcf"
hg38_map="/mnt/backedup/home/lijunX/local/Homo_sapiens.GRCh38.dna.primary_assembly.fa.r101.s501.blacklist.gz"


pycoQC -f $summary_output -a $bam_mapped -o "${wk_dir}/output/${SampleID}/QC/${SampleID}_pycoQC_output.html"

mosdepth -n -t 10 ${wk_dir}/output/${SampleID}/coverage/${SampleID}_unphased $bam_mapped

singularity exec $HOME/local/delly_v1.2.6.sif delly cnv -a -g $reference_fa \
-m  $hg38_map \
-c $delly_cnv_out -o $delly_cnv_out_bcf $bam_mapped
