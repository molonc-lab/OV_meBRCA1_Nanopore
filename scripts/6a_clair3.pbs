#PBS -r n
#PBS -l mem=100GB,walltime=20:00:00,ncpus=20
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load singularity/3.7.1
module load conda-envs/whatshap-2.3
module load samtools/1.20
module load bcftools/1.19
mkdir -p ${wk_dir}/output/${SampleID}/clair3

clair3_image="/working/genomeinfo/share/containers/singularity/clair3-v1.0.10.sif"

bam_mapped="${wk_dir}/output/${SampleID}/${SampleID}_mapped_sc.bam"

reference_fa="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/ref/reference/GCA_000001405.15_GRCh38_mus.GRCm39.fa"
if [ $SampleID == "UWB1_BRCA1" ]
then reference_fa="/working/lab_olgak/lijunX/reference_uwb1_brca1/GCA_000001405.15_GRCh38_brca1_plasmid_uwb1.fa"
fi
if [[ "$SampleID" =~ ^(OVCAR8|OVCAR8_LP_A6_30|OVCAR8_LP_H4_53|WEHI_CS62|UWB1)$ ]]
then reference_fa="/reference/genomes/GRCh38_no_alt_analysis_set/indexes/MINIMAP2/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa"
fi

singularity exec $clair3_image \
run_clair3.sh \
--bam_fn $bam_mapped \
--ref_fn $reference_fa \
--threads=20 \
--platform="ont" \
--model_path /working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/ref/clair3_models/r1041_e82_400bps_sup_v500 \
--enable_phasing \
--use_whatshap_for_final_output_haplotagging \
--use_whatshap_for_final_output_phasing \
--output=${wk_dir}/output/${SampleID}/clair3
