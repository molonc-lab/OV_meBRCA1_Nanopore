#PBS -l mem=200GB,walltime=200:00:00,ncpus=24
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load singularity/3.7.1
module load samtools/1.17

mkdir -p ${wk_dir}/output/${SampleID}/deepvariants

reference_fa="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/ref/reference/GCA_000001405.15_GRCh38_mus.GRCm39.fa"
if [ $SampleID == "UWB1_BRCA1" ]
then reference_fa="/working/lab_olgak/lijunX/reference_uwb1_brca1/GCA_000001405.15_GRCh38_brca1_plasmid_uwb1.fa"
fi
if [[ "$SampleID" =~ ^(OVCAR8|OVCAR8_LP_A6_30|WEHI_CS62|UWB1)$ ]]
then reference_fa="/reference/genomes/GRCh38_no_alt_analysis_set/indexes/MINIMAP2/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa"
fi


bam_mapped="${wk_dir}/output/${SampleID}/${SampleID}_mapped_sc.bam"
output_file_prefix="${wk_dir}/output/${SampleID}/deepvariants/${SampleID}"
repeat_rmask="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/ref/indel.repeat.hg38.mask"

singularity run /working/lab_nicw/jiaZ/imgs/deepvariant/deepvariant_1.6.1.sif \
run_deepvariant \
--model_type=ONT_R104 \
--ref=$reference_fa \
--intermediate_results_dir=${wk_dir}/output/${SampleID}/deepvariants \
--reads=${bam_mapped} \
--sample_name=${SampleID} \
--output_vcf=${output_file_prefix}.vcf.gz \
--output_gvcf=${output_file_prefix}.g.vcf.gz \
--num_shards 24

#less ${output_file_prefix}.vcf.gz | grep "^#" >${output_file_prefix}.indel.vcf
#less ${output_file_prefix}.vcf.gz | grep "PASS"| awk '!($5 ~ ",") && length($4)>=5 && length($4)<=50 {print $0}' >> ${output_file_prefix}.indel.vcf

