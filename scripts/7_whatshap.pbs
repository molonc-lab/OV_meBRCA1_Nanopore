#PBS -r n
#PBS -l mem=50GB,walltime=20:00:00,ncpus=12
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load python/3.9.13
module load samtools/1.17
mkdir -p ${wk_dir}/output/${SampleID}/whatshap

clair3_input="${wk_dir}/output/${SampleID}/clair3/phased_merge_output.vcf.gz"
# bam_mapped="${wk_dir}/output/${SampleID}/${SampleID}_mapped.bam"
bam_mapped="${wk_dir}/output/${SampleID}/${SampleID}_filtered_mapped.bam"
bam_output="${wk_dir}/output/${SampleID}/whatshap/${SampleID}_phased.bam"
phased_sorted="${wk_dir}/output/${SampleID}/whatshap/${SampleID}_phased_sorted"

reference_fa="/reference/genomes/GRCh38_no_alt_analysis_set/indexes/MINIMAP2/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa"
if [ $SampleID == "UWB1_BRCA1" ]
then reference_fa="/working/lab_olgak/lijunX/reference_uwb1_brca1/GCA_000001405.15_GRCh38_brca1_plasmid_uwb1.fa"
fi


#whatshap haplotag \
#--ignore-read-groups \
#--output $bam_output \
#--reference $reference_fa \
#--output-thread=6 \
#$clair3_input $bam_mapped


samtools sort -@12 -O BAM --write-index -o ${phased_sorted}.bam##idx##${phased_sorted}.bai $bam_output
