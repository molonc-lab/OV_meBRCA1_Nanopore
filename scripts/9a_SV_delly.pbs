#PBS -r n
#PBS -l mem=48GB,walltime=30:00:00,ncpus=2
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load singularity/3.7.1
module load samtools/1.17
export OMP_NUM_THREADS=2

reference_fa="/working/lab_nicw/jiaZ/data/genome/reference.fasta"
bam_mapped="${wk_dir}/output/${SampleID}/${SampleID}_mapped.bam"
blacklist="/mnt/backedup/home/lijunX/local/Homo_sapiens.GRCh38.dna.primary_assembly.fa.r101.s501.blacklist.gz"

mkdir -p ${wk_dir}/output/${SampleID}/SV
delly_sv_bcf="${wk_dir}/output/${SampleID}/SV/${SampleID}_sv.bcf"

singularity exec $HOME/local/delly_v1.2.6.sif delly lr -g $reference_fa \
-y ont \
-o $delly_sv_bcf \
$bam_mapped