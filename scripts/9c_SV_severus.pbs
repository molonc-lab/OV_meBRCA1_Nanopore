#PBS -N Severus
#PBS -r n
#PBS -l select=1:ncpus=24:mem=120GB,walltime=20:00:00
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load conda-envs/severus-1.5
mkdir -p ${wk_dir}/output/${SampleID}/severus

severus --target-bam ${wk_dir}/output/${SampleID}/clair3/phased_output.bam \
--out-dir ${wk_dir}/output/${SampleID}/severus \
-t 24 \
--vntr-bed ~/Severus/vntrs/human_GRCh38_no_alt_analysis_set.trf.bed \
--write-alignments --resolve-overlaps \
--phasing-vcf ${wk_dir}/output/${SampleID}/clair3/phased_merge_output.vcf.gz \
--output-read-ids --PON ~/Severus/pon/PoN_1000G_hg38_extended.tsv.gz
