#PBS -r n
#PBS -l mem=200GB,walltime=30:00:00,ncpus=32
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load conda-envs/savana-1.3.4 

reference_fa="/reference/genomes/GRCh38_no_alt_analysis_set/indexes/MINIMAP2/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa"
#if [ $SampleID == "UWB1_BRCA1" ]
#then reference_fa="/working/lab_olgak/lijunX/reference_uwb1_brca1/GCA_000001405.15_GRCh38_brca1_plasmid_uwb1.fa"
#fi
#if [[ "$SampleID" =~ ^(134|SOLACE|SFRC) ]]
#then 
#reference_fa="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/ref/reference/GCA_000001405.15_GRCh38_mus.GRCm39.fa"
#fi

bam_mapped="${wk_dir}/output/${SampleID}/${SampleID}_mapped_sc.bam"

mkdir -p ${wk_dir}/output/${SampleID}/savana

savana to -t ${bam_mapped} \
-r ${reference_fa} \
--threads 32 \
--cna_threads 32 \
--outdir ${wk_dir}/output/${SampleID}/savana \
-s ${SampleID} \
--main_cn_step_change 2 \
-b /working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/ref/hg38-blacklist.v2.bed \
--overrule_cellularity 1 \
-vg 1000g_hg38 \
--overwrite
