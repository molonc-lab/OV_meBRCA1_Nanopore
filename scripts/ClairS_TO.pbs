#PBS -r n
#PBS -l mem=40GB,walltime=30:00:00,ncpus=10
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID

wk_dir="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore"
bam_mapped="${wk_dir}/output/${SampleID}/${SampleID}_mapped.bam"
reference_fa="/reference/genomes/GRCh38_no_alt_analysis_set/indexes/MINIMAP2/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa"


mkdir -p ${wk_dir}/output/${SampleID}/clairs_to/

module load singularity/3.7.1
singularity exec \
  /working/genomeinfo/share/containers/singularity/clairs-to-0.1.0.sif \
  /opt/bin/run_clairs_to \
  --tumor_bam_fn ${bam_mapped} \
  --ref_fn $reference_fa \
  --threads 10 \
  --platform ont_r10_dorado_sup_4khz \
  --output_dir ${wk_dir}/output/${SampleID}/clairs_to/