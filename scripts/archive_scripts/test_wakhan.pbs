#PBS -r n
#PBS -l mem=60GB,walltime=10:00:00,ncpus=16
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

mkdir -p ${wk_dir}/output/${SampleID}/wakhan
haplotagged_bam=${wk_dir}/output/${SampleID}/clair3/phased_output.bam
phased_vcf=${wk_dir}/output/${SampleID}/clair3/phased_merge_output.vcf.gz
severus_sv_vcf=${wk_dir}/output/${SampleID}/severus/somatic_SVs/severus_somatic.vcf

reference_fa="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/ref/reference/GCA_000001405.15_GRCh38_mus.GRCm39.fa"
if [ $SampleID == "UWB1_BRCA1" ]
then reference_fa="/working/lab_olgak/lijunX/reference_uwb1_brca1/GCA_000001405.15_GRCh38_brca1_plasmid_uwb1.fa"
fi
if [[ "$SampleID" =~ ^(OVCAR8|OVCAR8_LP_A6_30|OVCAR8_LP_H4_53|WEHI_CS62|UWB1)$ ]]
then reference_fa="/reference/genomes/GRCh38_no_alt_analysis_set/indexes/MINIMAP2/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa"
fi

module load miniconda3/current
source activate Wakhan
module load bcftools/1.19
module load samtools/1.17
module load python/3.9.13
python /mnt/backedup/home/lijunX/local/Wakhan/wakhan.py \
--target-bam $haplotagged_bam \
--genome-name $SampleID \
--threads 16 \
--reference $reference_fa \
--tumor-vcf $phased_vcf \
--tumor-purity 1 \
--loh-enable \
--breakpoints $severus_sv_vcf \
--out-dir-plots ${wk_dir}/output/${SampleID}/wakhan

