#PBS -N delly
#PBS -r n
#PBS -l mem=48GB,walltime=30:00:00,ncpus=16
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID

module load singularity/3.7.1
module load samtools/1.17
export OMP_NUM_THREADS=16

wk_dir="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/"
reference_fa="/working/lab_nicw/jiaZ/data/genome/reference.fasta"
bam_mapped="${wk_dir}/output/${SampleID}/${SampleID}_mapped.bam"
hg38_map="/mnt/backedup/home/lijunX/local/Homo_sapiens.GRCh38.dna.primary_assembly.fa.r101.s501.blacklist.gz"
delly_cnv_out_bcf="${wk_dir}/output/${SampleID}/CNV/${SampleID}_delly_cnv_out.cov.bcf"
delly_cnv_out="${wk_dir}/output/${SampleID}/CNV/${SampleID}_delly_cnv_out.cov.gz"
delly_sv="${wk_dir}/output/${SampleID}/SV/${SampleID}_sv.bcf"

singularity exec $HOME/local/delly_v1.2.6.sif delly cnv -a -g $reference_fa \
-m $hg38_map -c $delly_cnv_out -l $delly_sv \
-o $delly_cnv_out_bcf $bam_mapped
