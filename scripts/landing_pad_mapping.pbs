module load samtools/1.17
module load minimap2/2.27
module load htslib/1.19.1

cd /working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/output/landing_pad_mapping

reference_fa="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/ref/reference/landingpad_hg38.fa"
trimmed_bam="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/output/OVCAR8_LP_A6_30/OVCAR8_LP_A6_30_trimmed_repaired.bam"
remapped_bam="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/output/landing_pad_mapping/OVCAR8_LP_A6_30_lp_mapped"

trimmed_bam_norm="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/output/OVCAR8/OVCAR8_sup.bam"
remapped_bam_norm="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/output/landing_pad_mapping/OVCAR8_lp_mapped"

# samtools fastq -T"*" $trimmed_bam | \
# minimap2 -ax map-ont -y -Y --MD --splice -t 24 $reference_fa - | \
# samtools sort -@8 -O BAM --write-index -o ${remapped_bam}.bam##idx##${remapped_bam}.bai

module load nanomonsv/0.7.1
module load mafft/7.471
module load racon/1.3.2
module load longread/python39venv

#nanomonsv parse ${remapped_bam}.bam ${remapped_bam}_nanomonsv
#nanomonsv parse ${remapped_bam_norm}.bam ${remapped_bamm_norm}_nanomonsv

nanomonsv get ${remapped_bam}_nanomonsv ${remapped_bam}.bam \
$reference_fa \
--use_racon --min_indel_size 10 \
--control_bam ${remapped_bam_norm}.bam \
--control_prefix ${remapped_bam_norm}_nanomonsv
--processes 23
