#PBS -N landing_pad_savana
#PBS -r n
#PBS -l select=1:ncpus=12:mem=200GB,walltime=20:00:00
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au

wk_dir="/working/lab_olgak/lijunX/OV_meBRCA1_Nanopore"

module load conda-envs/savana-1.0.5
conda activate /mnt/lustre/working/lab_nicw/jiaZ/local/micromanba_envs/savana1.20

reference_fa="/reference/genomes/GRCh38_no_alt_analysis_set/indexes/MINIMAP2/GCA_000001405.15_GRCh38_no_alt_analysis_set.fa"

mkdir -p ${wk_dir}/output/landing_pad_mapping/savana

savana --tumour ${wk_dir}/output/OVCAR8_LP_A6_30/OVCAR8_LP_A6_30_mapped.bam \
--normal ${wk_dir}/output/OVCAR8/OVCAR8_mapped.bam \
--outdir ${wk_dir}/output/landing_pad_mapping/savana \
--ref $reference_fa \
--phased_vcf ${wk_dir}/output/OVCAR8/clair3/phased_merge_output.vcf.gz \
--blacklist /working/lab_olgak/lijunX/OV_meBRCA1_Nanopore/ref/hg38-blacklist.v2.bed \
--predict_germline