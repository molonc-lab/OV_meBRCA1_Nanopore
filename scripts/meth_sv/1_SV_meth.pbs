#PBS -r n
#PBS -l mem=24GB,walltime=3:00:00,ncpus=1
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load htslib/1.19.1
module load samtools/1.20
module load R/4.3.1
modkit="${HOME}/local/modkit_v0.3.1/modkit"
module load python/3.9.13
module load bedtools/2.31.1 

sample_dir="${wk_dir}/output/${SampleID}"

# merge SV from severus and nanomonsv
Rscript ${wk_dir}/scripts/meth_sv/merge_severus_nanomonsv.R ${wk_dir} ${SampleID}

# subset 
samtools view -bh -L ${sample_dir}/${SampleID}_merged_sv.bed -@ 8 ${sample_dir}/${SampleID}_mapped_sc.bam > ${sample_dir}/${SampleID}_merged_sv.bam

# extract support read ID from nanomonsv output
python ${wk_dir}/scripts/meth_sv/extract_split_readid.py -b ${sample_dir}/${SampleID}_mapped_sc.bam \
-e ${sample_dir}/${SampleID}_merged_sv.bed \
-o ${sample_dir}/${SampleID}_merged_sv_readid.tsv

#extract methylation
$modkit extract --non-primary --force ${sample_dir}/${SampleID}_merged_sv.bam ${sample_dir}/${SampleID}_merged_SV_modkit_extract.tsv

# store read mapping subset by ref or alt
Rscript ${wk_dir}/scripts/meth_sv/get_read_mapping.R ${wk_dir} ${SampleID}


# deletion
Rscript ${wk_dir}/scripts/meth_sv/get_del_meth.R ${wk_dir} ${SampleID}
