#PBS -r n
#PBS -l mem=24GB,walltime=1:00:00,ncpus=1
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load htslib/1.19.1
module load samtools/1.20
module load R/4.3.1
modkit="${HOME}/local/modkit_v0.3.1/modkit"

sample_dir="${wk_dir}/output/${SampleID}"
Rscript ${wk_dir}/scripts/meth_sv/get_ins_readid.R ${wk_dir} ${SampleID}

#get alt seq cigar
samtools view -N ${sample_dir}/ins_read_name.tsv \
${sample_dir}/${SampleID}_merged_sv.bam|cut -f 1,2,3,4,6 > ${sample_dir}/ins_read_name_primary_map.tsv 

#extract BND meth for both ref and alt 
Rscript ${wk_dir}/scripts/meth_sv/get_ins_meth.R ${wk_dir} ${SampleID}[lijunX@hpcpbs01 meth_sv]$ cat 2_BND_meth.pbs 
#PBS -r n
#PBS -l mem=24GB,walltime=1:00:00,ncpus=1
#PBS -m ae
#PBS -M lijun.xu@qimrberghofer.edu.au
#PBS -v SampleID
#PBS -v wk_dir

module load htslib/1.19.1
module load samtools/1.20
module load R/4.3.1
modkit="${HOME}/local/modkit_v0.3.1/modkit"


sample_dir="${wk_dir}/output/${SampleID}"
Rscript ${wk_dir}/scripts/meth_sv/get_bnd_readid.R ${wk_dir} ${SampleID}


#get alt seq alignment that is not fully mapped
samtools view -N ${sample_dir}/bnd_read_name_saf_tag.tsv \
${sample_dir}/${SampleID}_merged_sv.bam|cut -f 1,21 > ${sample_dir}/bnd_read_name_saf_map.tsv

samtools view -N ${sample_dir}/bnd_read_name_saf_tag.tsv \
${sample_dir}/${SampleID}_merged_sv.bam|cut -f 1,2,3,4,6 > ${sample_dir}/bnd_read_name_primary_map.tsv 

#extract BND meth for both ref and alt 
Rscript ${wk_dir}/scripts/meth_sv/get_bnd_meth.R ${wk_dir} ${SampleID}
